# Private key de Vapi (Dashboard > API Keys > Private).
# Server-side: NUNCA usar prefijo NEXT_PUBLIC_ (expondría la llave al browser).
# Sin esta llave, el modulo de Llamadas del dashboard usa datos demo.
VAPI_PRIVATE_KEY=

# --- WhatsApp Cloud API (Meta) ---
# Verify token: lo inventas tú; debe coincidir con el del panel de Meta.
WHATSAPP_VERIFY_TOKEN=
# App Secret de la App de Meta (valida la firma X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
# Para responder mensajes (no requeridos solo para recibir):
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- OAuth de Meta (conectar Facebook + Instagram de cada cliente) ---
# App "MiAgentIA" (tipo Negocios). El App ID no es secreto; el secret SÍ.
# Sin META_APP_SECRET el botón "Conectar" corre en modo demo (simulado).
META_APP_ID=1049131010901646
META_APP_SECRET=
# URL fija registrada en Meta. En dev se usa el origin local automáticamente.
META_REDIRECT_URI=https://conectar.miagentia.com/api/meta/callback
# Opcional: secreto propio para firmar el state (si no, usa META_APP_SECRET).
META_STATE_SECRET=
# Verify token del webhook de Messenger/Instagram (/api/webhooks/meta): lo
# inventas tú y debe coincidir con el que pegues en el panel de Meta
# (Webhooks > Verificar token).
META_WEBHOOK_VERIFY_TOKEN=

# --- Supabase (persistencia de mensajes de WhatsApp) ---
# Sin estas, los mensajes caen a un store en memoria (se pierden al reiniciar).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Dashboard de llamadas (Vapi) ---
# Private key de Vapi. Solo servidor. Sin esta variable el dashboard usa datos demo.
VAPI_PRIVATE_KEY=
# USD por minuto que cobra el carrier (Tigo). Vapi NO lo incluye: su campo
# transport llega en 0 porque el trunk es propio. En 0 o vacio, la UI oculta el
# costo real y solo muestra el de Vapi.
CARRIER_RATE_PER_MINUTE=

# --- Sistema de reservas del hotel (tenant "hotel", Cloudbeds API v1.3) ---
# SOLO LECTURA: el codigo nunca escribe en el PMS (ver lib/cloudbeds.ts).
# Sin estas variables, el dashboard del hotel avisa que no hay conexion.
# La key va en el header x-api-key y NO puede llevar prefijo NEXT_PUBLIC_.
# OJO: caduca si pasan 30 dias sin usarla.
CLOUDBEDS_API_KEY=
CLOUDBEDS_PROPERTY_ID=

# --- Seguridad de la sesion (IMPORTANTE) ---
# Secreto para firmar la cookie de sesion. Minimo 16 caracteres, aleatorio.
# Sin esto las sesiones son FALSIFICABLES. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Contrasenas de acceso. Si se define, las del repo (que es PUBLICO) dejan de
# funcionar. Formato: "tenant:clave,tenant:clave"
#   LOGIN_PASSWORDS="hospital:xxx,grupoq:yyy,excel:zzz,miagentia:www,hotel:aaa,inmobiliaria:bbb,promerica:ccc"
LOGIN_PASSWORDS=

# --- Cobros (tenant Banco Promerica) ---
# Secreto compartido del webhook de Vapi (mismo valor en el panel de Vapi,
# Server URL -> headers: x-vapi-secret). Sin el, /api/webhooks/vapi responde 401
# a todo: es una ruta publica y sin secreto cualquiera podria inventar llamadas
# y mover fichas de clientes.
VAPI_WEBHOOK_SECRET=
# Modelo que lee los transcripts de cobranza. Por defecto claude-opus-5.
# COBROS_AI_MODEL=claude-haiku-4-5
# 1 = las llamadas simuladas tambien pasan por el modelo, para probar el
# analisis sin telefonia. Cuesta dinero por cada llamada simulada.
# COBROS_IA_EN_SIMULACION=0
